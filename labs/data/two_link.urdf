<?xml version="1.0"?>
<!-- Teaching planar geometry and kinematics only. Not a dynamic/hardware model. -->
<robot name="training_two_link">
  <link name="base">
    <visual><geometry><box size="0.05 0.05 0.02"/></geometry></visual>
  </link>
  <link name="link1">
    <visual><origin xyz="0.15 0 0"/><geometry><box size="0.3 0.02 0.01"/></geometry></visual>
    <collision><origin xyz="0.15 0 0"/><geometry><box size="0.3 0.02 0.01"/></geometry></collision>
  </link>
  <joint name="q1" type="revolute">
    <parent link="base"/><child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" velocity="1" effort="2"/>
  </joint>
  <link name="link2">
    <visual><origin xyz="0.1 0 0"/><geometry><box size="0.2 0.02 0.01"/></geometry></visual>
    <collision><origin xyz="0.1 0 0"/><geometry><box size="0.2 0.02 0.01"/></geometry></collision>
  </link>
  <joint name="q2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" velocity="1" effort="2"/>
  </joint>
  <link name="tool"/>
  <joint name="tool_offset" type="fixed">
    <parent link="link2"/><child link="tool"/>
    <origin xyz="0.2 0 0" rpy="0 0 0"/>
  </joint>
</robot>
